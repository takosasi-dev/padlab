<Page ScrollViewer.CanContentScroll="False" x:Class="PadLab.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PadLab.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static local:Strings.NavSettings}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static local:Strings.SettingsAppliedNote}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="{x:Static local:Strings.SettingsDisplay}" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
            <ui:ToggleSwitch Content="{x:Static local:Strings.SettingReduceMotion}" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" Margin="0,4" />
            <ui:ToggleSwitch Content="{x:Static local:Strings.SettingLightTheme}" IsChecked="{Binding LightTheme, Mode=TwoWay}" Margin="0,4" />
            <ui:ToggleSwitch Content="{x:Static local:Strings.SettingShowPolling}" IsChecked="{Binding ShowPollingRate, Mode=TwoWay}" Margin="0,4" />
            <ui:ToggleSwitch Content="{x:Static local:Strings.SettingShowFake}" IsChecked="{Binding ShowFakeDevice, Mode=TwoWay}" Margin="0,4" />
            <TextBlock Text="{x:Static local:Strings.SettingFakeKind}" Margin="0,8,0,2" />
            <ComboBox ItemsSource="{Binding FakeKinds}" SelectedItem="{Binding FakeKind, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Static local:Strings.SettingsRestartNote}" Margin="0,4,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="{x:Static local:Strings.SettingsThresholds}" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
            <TextBlock Text="{x:Static local:Strings.SettingsDriftMinor}" Margin="0,4,0,2" />
            <ui:NumberBox Value="{Binding DriftMinor, Mode=TwoWay}" Minimum="0.005" Maximum="0.5" SmallChange="0.005" MaxDecimalPlaces="3" FontFamily="Consolas, Cascadia Mono" Width="200" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Static local:Strings.SettingsDriftNotable}" Margin="0,8,0,2" />
            <ui:NumberBox Value="{Binding DriftNotable, Mode=TwoWay}" Minimum="0.005" Maximum="0.9" SmallChange="0.005" MaxDecimalPlaces="3" FontFamily="Consolas, Cascadia Mono" Width="200" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Static local:Strings.SettingsChatterGap}" Margin="0,8,0,2" />
            <ui:NumberBox Value="{Binding ChatterGapMs, Mode=TwoWay}" Minimum="1" Maximum="100" SmallChange="1" MaxDecimalPlaces="1" FontFamily="Consolas, Cascadia Mono" Width="200" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Static local:Strings.SettingsIdleMinutes}" Margin="0,8,0,2" />
            <ui:NumberBox Value="{Binding IdleMinutes, Mode=TwoWay}" Minimum="1" Maximum="180" SmallChange="1" MaxDecimalPlaces="0" FontFamily="Consolas, Cascadia Mono" Width="200" HorizontalAlignment="Left" />

            <TextBlock Text="{x:Static local:Strings.SettingsOther}" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
            <ui:ToggleSwitch Content="{x:Static local:Strings.SettingSound}" IsChecked="{Binding SoundEnabled, Mode=TwoWay}" Margin="0,4" />
            <TextBlock Text="{x:Static local:Strings.SettingsSoundNote}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:ToggleSwitch Content="{x:Static local:Strings.SettingAllowNetwork}" IsChecked="{Binding AllowNetwork, Mode=TwoWay}" Margin="0,12,0,4" />
            <TextBlock Text="{x:Static local:Strings.SettingsNetworkNote}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Static local:Strings.NoNetwork}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="{Binding FilePath}" Margin="0,24,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
