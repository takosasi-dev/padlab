<Page ScrollViewer.CanContentScroll="False" x:Class="PadLab.App.Pages.DriftPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PadLab.App"
      xmlns:r="clr-namespace:PadLab.App.Rendering"
      xmlns:vm="clr-namespace:PadLab.App.ViewModels"
      Title="{x:Static local:Strings.NavDrift}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <DataTemplate x:Key="StickTemplate" DataType="{x:Type vm:StickDriftViewModel}">
            <StackPanel Margin="0,0,24,0" MinWidth="220">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Verdict}" FontSize="16" Margin="0,4,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Max}" Style="{StaticResource Mono}" />
                <TextBlock Text="{Binding Mean}" Style="{StaticResource Mono}" />
                <TextBlock Text="{Binding Angle}" Style="{StaticResource Mono}" />
                <TextBlock Text="{Binding Exceed}" Style="{StaticResource Mono}" />
                <TextBlock Text="{Binding Center}" Style="{StaticResource Mono}" />
                <TextBlock Text="{Binding Compare}" Style="{StaticResource Mono}" Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <r:SkiaCanvasView x:Name="Canvas" />
            <TextBlock x:Name="NoDeviceText" Text="{x:Static local:Strings.NoDevice}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
        <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Thresholds}" Margin="0,4,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="{x:Static local:Strings.DriftStart}" Command="{Binding StartCommand}" Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{x:Static local:Strings.DriftRestart}" Command="{Binding StartCommand}" Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{x:Static local:Strings.DriftSave}" Command="{Binding SaveCommand}" Margin="8,0,0,0" Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding Saved}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}">
                    <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource StickTemplate}" />
                    <ContentControl Content="{Binding Right}" ContentTemplate="{StaticResource StickTemplate}" />
                </StackPanel>

                <TextBlock Text="{x:Static local:Strings.CompareTitle}" FontWeight="SemiBold" Margin="0,16,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding CompareStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding PastSessions}" SelectedItem="{Binding SelectedSession}" MinWidth="320" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas, Cascadia Mono">
                                <Run Text="{Binding MeasuredAt, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}" />
                                <Run Text="{Binding DeviceType, Mode=OneWay}" />
                                <Run Text="{Binding Connection, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{x:Static local:Strings.DeadzoneTitle}" FontWeight="SemiBold" Margin="0,16,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Deadzone}" FontSize="22" Style="{StaticResource Mono}" />
                <TextBlock Text="{Binding DeadzoneRationale}" TextWrapping="Wrap" Style="{StaticResource Mono}" />
                <TextBlock Text="{Binding DeadzoneHints}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Static local:Strings.DeadzoneTradeoff}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Static local:Strings.ReferenceOnly}" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
