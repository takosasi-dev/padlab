<Page ScrollViewer.CanContentScroll="False" x:Class="PadLab.App.Pages.PrecisionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PadLab.App"
      xmlns:r="clr-namespace:PadLab.App.Rendering">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="{x:Static local:Strings.NavPrecision}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="NoDeviceText" Text="{x:Static local:Strings.NoDeviceHint}" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid x:Name="Body" Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding StepTitle}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Guide}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <StackPanel Visibility="{Binding IsStickStep, Converter={StaticResource B2V}}" Margin="0,12,0,0">
                        <RadioButton Content="{x:Static local:Strings.LeftStick}" IsChecked="{Binding IsLeft, Mode=TwoWay}" />
                        <RadioButton Content="{x:Static local:Strings.RightStick}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Progress}" FontFamily="Consolas, Cascadia Mono" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ChatterLimit}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="{x:Static local:Strings.PrecBack}" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static local:Strings.PrecStart}" Command="{Binding StartCommand}" Margin="0,0,8,0" Appearance="Primary"
                                   Visibility="{Binding IsTestStep, Converter={StaticResource B2V}}" />
                        <ui:Button Content="{x:Static local:Strings.PrecNext}" Command="{Binding NextCommand}" Margin="0,0,8,0" />
                    </WrapPanel>
                    <StackPanel Visibility="{Binding IsResultsStep, Converter={StaticResource B2V}}" Margin="0,16,0,0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static local:Strings.PrecColItem}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Static local:Strings.PrecColNow}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{x:Static local:Strings.PrecColPrev}" FontWeight="SemiBold" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Item}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Now}" FontFamily="Consolas, Cascadia Mono" />
                                        <TextBlock Grid.Column="2" Text="{Binding Prev}" FontFamily="Consolas, Cascadia Mono" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static local:Strings.PrecNotesLabel}" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" />
                        <ui:Button Content="{x:Static local:Strings.PrecSave}" Command="{Binding SaveCommand}" Margin="0,8,0,0" Appearance="Primary" />
                        <TextBlock Text="{Binding Saved}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <r:SkiaCanvasView x:Name="Canvas" Grid.Column="2" IsActive="False" />
        </Grid>
    </Grid>
</Page>
