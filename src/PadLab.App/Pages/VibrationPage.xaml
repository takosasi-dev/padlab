<Page ScrollViewer.CanContentScroll="False" x:Class="PadLab.App.Pages.VibrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PadLab.App"
      xmlns:r="clr-namespace:PadLab.App.Rendering">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="{x:Static local:Strings.NavVibration}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="NoDeviceText" Text="{x:Static local:Strings.NoDeviceHint}" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Static local:Strings.VibHint}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid x:Name="Body" Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                        IsEnabled="{Binding Supported}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding UnsupportedText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,8,0,0">
                                            <ui:ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}" Content="ON" />
                                            <TextBlock Text="{Binding StrengthText}" DockPanel.Dock="Right" FontFamily="Consolas, Cascadia Mono" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <Slider Minimum="0" Maximum="100" Value="{Binding Strength, Mode=TwoWay}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <WrapPanel Margin="0,8,0,0">
                                            <ui:Button Content="{x:Static local:Strings.VibSweep}" Command="{Binding SweepCommand}" Margin="0,0,8,0" />
                                            <ui:Button Content="{x:Static local:Strings.VibFelt}" Command="{Binding FeltCommand}" Margin="0,0,8,0" />
                                            <ui:Button Content="{x:Static local:Strings.VibNotFelt}" Command="{Binding NotFeltCommand}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Report}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Content="{x:Static local:Strings.VibStopAll}" Command="{Binding StopAllCommand}" />
                    <TextBlock Text="{Binding CommandText}" FontFamily="Consolas, Cascadia Mono" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
            <r:SkiaCanvasView x:Name="Canvas" Grid.Column="2" IsActive="False" />
        </Grid>
    </Grid>
</Page>
