<Page ScrollViewer.CanContentScroll="False" x:Class="PadLab.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:PadLab.App">
    <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="{x:Static local:Strings.AppTitle}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Version}" FontFamily="Consolas, Cascadia Mono" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{x:Static local:Strings.AboutDescription}" TextWrapping="Wrap" Margin="0,16,0,0" />
        <TextBlock Text="{x:Static local:Strings.NoNetwork}" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold" />
        <TextBlock Text="{x:Static local:Strings.ReferenceOnly}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SessionsDir}" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <WrapPanel Margin="0,12,0,0">
            <ui:Button Content="{x:Static local:Strings.AboutOpenFolder}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
            <ui:Button Content="{x:Static local:Strings.AboutThirdParty}" Command="{Binding OpenNoticesCommand}" />
        </WrapPanel>
        <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</Page>
