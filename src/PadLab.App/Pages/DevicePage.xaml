<Page ScrollViewer.CanContentScroll="False" x:Class="PadLab.App.Pages.DevicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PadLab.App"
      xmlns:vm="clr-namespace:PadLab.App.ViewModels"
      Title="{x:Static local:Strings.NavDevice}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{x:Static local:Strings.DeviceListTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="{x:Static local:Strings.DeviceListEmpty}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceCardViewModel}">
                        <Border Width="300" Margin="0,0,16,16" Padding="16" CornerRadius="8" Loaded="Card_Loaded"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Vendor}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                    <TextBlock Text="{Binding Connection}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Polling}" Margin="16,0,0,0" FontFamily="Consolas, Cascadia Mono"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Content="{x:Static local:Strings.DeviceSelect}" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsNotSelected, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{x:Static local:Strings.DeviceSelected}" FontWeight="SemiBold"
                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
