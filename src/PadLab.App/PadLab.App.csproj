<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PadLab.Input\PadLab.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.151.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><AssemblyName>PadLab</AssemblyName><ApplicationIcon></ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Track A/B/C の成果物が揃ったら AppState / DeviceSession をコンパイルに含める (Services/AppState.cs 参照) -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\PadLab.Core\Analysis\PaddleMapper.cs') And Exists('$(MSBuildThisFileDirectory)..\PadLab.Core\Recording\SessionStore.cs') And Exists('$(MSBuildThisFileDirectory)..\PadLab.Input\WindowsDeviceWatcher.cs')">
    <DefineConstants>$(DefineConstants);TRACKS_READY</DefineConstants>
  </PropertyGroup>

</Project>
